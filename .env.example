# Chế độ lưu trữ được chọn bằng biến môi trường (xem backend/db.ts):
#   DATABASE_URL có giá trị  -> PostgreSQL
#   DATABASE_URL để trống    -> In-memory (dữ liệu mất khi restart; chỉ để dev/demo)
#   USE_MEMORY_DB=true       -> ép in-memory dù đã có DATABASE_URL
#
# DATABASE_URL=postgresql://user:password@localhost:5432/logipro
# USE_MEMORY_DB=false

PORT=3000
TZ=Asia/Ho_Chi_Minh

# Khóa cho endpoint /api/cron/sync. Nên đặt giá trị riêng ở production.
# CRON_SECRET=

# Build frontend: đổi base path nếu không chạy dưới /QD209/ (Vercel tự dùng '/').
# VITE_BASE=/
